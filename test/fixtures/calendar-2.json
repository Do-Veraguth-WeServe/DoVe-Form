=\"n41\"></span><span id=\"p41\" class=\"pip\"></span></button></td></tr></tbody></table><section class=\"panel\"><h3 id=\"selTitle\">Notizen</h3><ul id=\"list\" class=\"notes\"></ul><div class=\"row\"><input id=\"draft\" type=\"text\" placeholder=\"Neue Notiz …\"><button id=\"add\">+</button></div><small id=\"err\"></small></section></main>",
  "css": "main{max-width:420px;margin:0 auto;font-family:system-ui,sans-serif}.bar{display:flex;align-items:center;gap:6px;margin-bottom:8px}.bar h2{flex:1;margin:0;font-size:17px}.nav{background:#20262a;border:1px solid #333;color:#e9e9de;border-radius:8px;padding:6px 10px;cursor:pointer;font-size:13px}.cal{width:100%;border-collapse:collapse;table-layout:fixed}.cal th{font-size:11px;color:#8b938f;font-weight:600;padding:4px 0}.cal td{padding:2px;text-align:center}.day{width:100%;padding:6px 0;background:transparent;border:none;border-radius:8px;color:#e9e9de;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:1px;font-size:13px}.day[aria-pressed=\"true\"]{background:#d4ef8b;color:#141718;font-weight:700}.pip{color:#d4ef8b;font-size:8px;line-height:1;min-height:8px}.day[aria-pressed=\"true\"] .pip{color:#141718}.panel{margin-top:12px;border-top:1px solid #2a3033;padding-top:10px}.panel h3{margin:0 0 6px;font-size:14px}.notes{list-style:none;margin:0;padding:0}.notes li{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:8px;background:#1b2022;margin-bottom:4px;font-size:13px}.notes li.empty{background:transparent;color:#8b938f}.nt{flex:1}.x{background:transparent;border:none;color:#8b938f;cursor:pointer;font-size:15px;padding:0 4px}.row{display:flex;gap:6px;margin-top:6px}.row input{flex:1;background:#1b2022;border:1px solid #333;color:#e9e9de;border-radius:8px;padding:8px 10px;font-size:13px;min-width:0}.row button{background:#d4ef8b;border:none;color:#141718;border-radius:8px;padding:0 14px;font-size:18px;font-weight:700;cursor:pointer}small{color:#e08a7a;font-size:11px}",
  "js": "var MON=['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];var now=new Date();var TY=now.getFullYear(),TM=now.getMonth(),TD=now.getDate();var notes=[],cells=[];function pad(n){return n<10?'0'+n:String(n);}function iso(y,m,d){return y+'-'+pad(m+1)+'-'+pad(d);}function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}function fmtDate(s){var p=s.split('-');return p[2]+'.'+p[1]+'.'+p[0];}function notesFor(d){var a=[],i;for(i=0;i<notes.length;i++){if(notes[i].date===d)a.push(notes[i]);}return a;}if(typeof state.y!=='number'){state.y=TY;state.m=TM;}if(typeof state.sel!=='string'){state.sel=iso(TY,TM,TD);}if(typeof state.draft!=='string'){state.draft='';}function loadNotes(){ui.db.select('notes',{},function(x){if(x&&x.ok){notes=x.rows;}renderCal();renderNotes();});}function renderCal(){ui.text('title',MON[state.m]+' '+state.y);var first=new Date(state.y,state.m,1).getDay();first=(first+6)%7;var len=new Date(state.y,state.m+1,0).getDate();cells=[];var i;for(i=0;i<42;i++){cells.push(null);}for(i=0;i<len;i++){cells[first+i]=iso(state.y,state.m,i+1);}for(i=0;i<42;i++){var d=cells[i];ui.attr('b'+i,'aria-pressed',d===state.sel?'true':'false');if(d){ui.text('n'+i,String(i-first+1));ui.html('p'+i,notesFor(d).length?'●':'');}else{ui.text('n'+i,'');ui.html('p'+i,'');}}}function renderNotes(){ui.text('selTitle','Notizen · '+fmtDate(state.sel));var rows=notesFor(state.sel),h='',i;if(rows.length){for(i=0;i<rows.length;i++){h+='<li><span class=\"nt\">'+esc(rows[i].txt)+'</span><button id=\"del'+rows[i].id+'\" class=\"x\" aria-label=\"löschen\">×</button></li>';}}else{h='<li class=\"empty\">Keine Notizen an diesem Tag.</li>';}ui.html('list',h);for(i=0;i<rows.length;i++){(function(id){ui.on('del'+id,'click',function(){ui.db.delete('notes',id,function(){loadNotes();});});})(rows[i].id);}}ui.on('prev','click',function(){state.m--;if(state.m<0){state.m=11;state.y--;}ui.persist();renderCal();});ui.on('next','click',function(){state.m++;if(state.m>11){state.m=0;state.y++;}ui.persist();renderCal();});ui.on('today','click',function(){state.y=TY;state.m=TM;state.sel=iso(TY,TM,TD);ui.persist();renderCal();renderNotes();});ui.on('draft','input',function(e){state.draft=e.value;});ui.on('add','click',function(){var t=String(state.draft||'').replace(/^\\s+|\\s+$/g,'');if(!t){ui.text('err','Bitte erst etwas eintippen.');return;}ui.text('err','');ui.db.insert('notes',{date:state.sel,txt:t},function(r){if(r&&r.ok){state.draft='';ui.value('draft','');ui.persist();loadNotes();}else{ui.text('err',(r&&r.error)||'Fehler beim Speichern.');}});});for(var i=0;i<42;i++){(function(i){ui.on('b'+i,'click',function(){if(cells[i]){state.sel=cells[i];ui.persist();renderCal();renderNotes();}});})(i);}ui.value('draft',state.draft||'');ui.db.create('notes',['date','txt'],function(){loadNotes();});",
