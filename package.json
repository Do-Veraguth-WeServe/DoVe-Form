{
  "name": "form3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Form v3 — local interactive AI chat. Two-phase answers (prose + one sandboxed artifact), any OpenAI-compatible provider, runs entirely on your machine.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node server.mjs",
    "start": "node server.mjs",
    "test": "node test/run-all.mjs",
    "test:unit": "node --test test/unit.test.mjs"
  },
  "dependencies": {
    "quickjs-emscripten": "0.32.0",
    "dompurify": "3.4.17",
    "css-tree": "3.2.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.63.0"
  }
}
